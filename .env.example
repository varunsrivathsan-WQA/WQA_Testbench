# ---- Required in production ----
# Random 32+ character string. Signs sessions, asset links and password cookies.
NEXTAUTH_SECRET=
# The public URL of this site, e.g. https://tests.wearewqa.com
NEXTAUTH_URL=http://localhost:3000

# Google OAuth client (Google Cloud console > Credentials > OAuth client ID, type "Web").
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these email domains can sign in (comma separated).
ALLOWED_DOMAINS=wearewqa.com

# ---- Storage (added automatically when you connect them in the Vercel dashboard) ----
# Vercel Blob: holds uploaded files. When creating the store, tick
# "Add a read-write token env var" so this is set.
BLOB_READ_WRITE_TOKEN=
# "private" (default, recommended) or "public". Must match the store's Access setting.
BLOB_ACCESS=private
# Upstash Redis (Vercel Marketplace): holds drops, templates and responses.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional ----
# Lifespan choices shown when publishing. d = days, h = hours.
LIFESPANS=1d,2d,7d,30d
DEFAULT_LIFESPAN=7d
# People who can edit every template, not just their own (comma separated emails).
TEMPLATE_ADMINS=
# Vercel sends this to the nightly clean-up job. Set any random string.
CRON_SECRET=
